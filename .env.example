# lifeproj illustration engine — server-only credentials (AR11).
# Copy this file to `.env` (gitignored) and fill in real values.
# These are read exclusively via `$env/static/private` inside src/lib/server/lifeproj/.
# The API key must NEVER reach the browser bundle.

LIFEPROJ_API_KEY=
LIFEPROJ_BASE_URL=
