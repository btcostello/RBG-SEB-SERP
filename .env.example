# Server-only environment. Copy this file to `.env` (gitignored) and fill in real values.
# All of these are read via `$env/dynamic/private` inside src/lib/server/ and NEVER reach the
# browser bundle.

# --- lifeproj illustration engine (AR11) ---
# The API key must NEVER be exposed client-side.
LIFEPROJ_API_KEY=
LIFEPROJ_BASE_URL=

# --- Saved-quotes database (Postgres) ---
# Local dev: run `docker compose up -d` and use the string below (matches docker-compose.yml).
# Production (Railway): attach a Postgres plugin and reference its injected DATABASE_URL.
DATABASE_URL=postgres://schiff:schiff@localhost:5432/schiff
